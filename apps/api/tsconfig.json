{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2023",
    "strict": true,
    // DTOs and entities are hydrated by class-transformer / TypeORM rather than constructors.
    "strictPropertyInitialization": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "removeComments": true,
    "sourceMap": true,
    "outDir": "./dist",
    "types": ["node", "jest"]
  },
  "include": ["src", "test"],
  "ts-node": {
    // Dev-only scripts (migrations, seed) skip type checking for speed; `npm run typecheck` covers it.
    "transpileOnly": true
  }
}
