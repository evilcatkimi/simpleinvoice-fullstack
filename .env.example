# SimpleInvoice environment template.
# Run ./scripts/init-env.sh to create .env from this file with random secrets (it also adds the variables a newer
# version introduces to an existing .env), or copy it manually and fill every empty value. Never commit .env.

# ---------- Published host ports (docker compose) ----------
WEB_PORT=3000
API_PORT=4000
DB_HOST_PORT=5434

# ---------- Docker network (docker compose) ----------
# nginx has a fixed address on the web<->api network, and the API trusts X-Forwarded-For from that address only.
# Change the three together if 10.203.47.0/24 clashes with a VPN or LAN route (then `docker compose down` once).
# EDGE_SUBNET=10.203.47.0/24
# EDGE_IP_RANGE=10.203.47.128/25
# WEB_PROXY_IP=10.203.47.10

# ---------- PostgreSQL ----------
# Bootstrap superuser of the db container: used once, on an empty volume, to create the database and the roles below.
POSTGRES_USER=simple_invoice
POSTGRES_PASSWORD=
POSTGRES_DB=simple_invoice
# Schema owner: runs the migrations and the seed (compose `migrate` service, npm run migration:run / seed).
DB_MIGRATION_USER=simple_invoice_owner
DB_MIGRATION_PASSWORD=

# ---------- API (also used when running apps/api locally without Docker) ----------
NODE_ENV=development
PORT=4000
# Local run against the dockerised DB: localhost + DB_HOST_PORT. Compose overrides these to db:5432.
DB_HOST=localhost
DB_PORT=5434
# The API's runtime role: reads and inserts rows, nothing else (no DDL, not a superuser).
DB_USER=simple_invoice_app
DB_PASSWORD=
DB_NAME=simple_invoice
DB_SSL=false

# HS256 signing key: at least 32 characters, generated (init-env.sh: openssl rand -hex 32); placeholders are refused
JWT_SECRET=
# Access-token lifetime in seconds (spec default: 3600)
JWT_EXPIRES_IN=3600
JWT_ISSUER=simple-invoice-api
JWT_AUDIENCE=simple-invoice-web

# Set to true when served over HTTPS: the session cookie then gets Secure and the __Host- prefix
COOKIE_SECURE=false
# Browser origins allowed to call the API with credentials. Empty = CORS disabled, which is all the SPA needs (it is
# same-origin behind nginx and the Vite proxy). Opt in only for another trusted front end, e.g. https://admin.example.com
CORS_ORIGINS=
# Which reverse proxies may set the client IP (the rate-limiting key) through X-Forwarded-For:
# 0 = ignore X-Forwarded-For (API reached directly); behind a proxy, list its IP or CIDR. A hop count (1, 2, ...) is
# only safe when nothing but that proxy can reach the API port. Compose sets the nginx address itself.
TRUST_PROXY=0
# IANA timezone used to decide "today" when deriving the Overdue status
APP_TIMEZONE=UTC
# Swagger UI at /api/docs (the API's default is off when NODE_ENV=production; the review stack enables it)
SWAGGER_ENABLED=true
LOG_LEVEL=info

# Brute-force protection on POST /auth/login, per client IP (requests per window)
THROTTLE_LOGIN_LIMIT=5
THROTTLE_LOGIN_TTL_SECONDS=60
# ... and per account, whatever the IP: failed logins per window, then 429 until the window ends
LOGIN_MAX_FAILED_ATTEMPTS=10
LOGIN_FAILURE_WINDOW_SECONDS=900
# bcrypt work factor of password hashes: 4-15, at least 10 when NODE_ENV=production. Each step doubles the time per
# hash (12: about 250 ms). The API and the seed must use the same value; compose passes it to both.
BCRYPT_COST=12

# ---------- Seed (compose `migrate` service, npm run seed) ----------
# Demo reviewer account required by the assessment and documented in README.md.
# Change it for any environment that is not a local review.
SEED_ADMIN_EMAIL=reviewer@simpleinvoice.dev
SEED_ADMIN_PASSWORD=
# Local review only: lets NODE_ENV=production seed the publicly documented demo password. init-env.sh sets it to true
# together with that password; anywhere else, leave it false and choose a unique SEED_ADMIN_PASSWORD.
SEED_ALLOW_DEMO_PASSWORD=false
# With NODE_ENV=production, an existing admin keeps its current (possibly rotated) password unless this is true.
SEED_RESET_ADMIN_PASSWORD=false
